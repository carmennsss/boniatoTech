<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fileManager"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    android:background="@drawable/fondo2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_marginTop="60dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/cream"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tituloFileManager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/green"
                android:textSize="35dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtituloFileManager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="6dp"
                android:textColor="@color/green"
                android:textSize="15dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="200dp"
                    android:layout_height="300dp"
                    android:orientation="vertical"
                    android:background="@color/white">
                    <TextView
                    android:id="@+id/fileListHeader1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"/>
                    <TextView
                        android:id="@+id/fileListHeader2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"/>
                    <ImageButton
                        android:id="@+id/botonInfoArchivos"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_margin="30dp"
                        android:background="@drawable/round_button_background"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        app:tint="@color/purple"
                        app:srcCompat="@android:drawable/ic_dialog_info" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView
                        android:id="@+id/actionsLabel"
                        android:layout_marginBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:textColor="@color/black"/>
                    <Button
                        android:id="@+id/botonUpload"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:backgroundTint="@color/mediumGreen"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="1dp" />
                    <Button
                        android:id="@+id/botonDownload"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:backgroundTint="@color/mediumGreen"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="1dp" />
                    <Button
                        android:id="@+id/botonDelete"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:backgroundTint="@color/red"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="1dp" />
                    <Button
                        android:id="@+id/botonNewFolder"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:backgroundTint="@color/mediumGreen"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="1dp" />
                    <Button
                        android:id="@+id/botonDeleteFolder"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:backgroundTint="@color/red"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="1dp" />
                    <Button
                        android:id="@+id/botonRename"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:backgroundTint="@color/mediumGreen"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="1dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:layout_margin="6dp"
                    android:id="@+id/botonVueltaMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:backgroundTint="@color/lightGray"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:cornerRadius="1dp" />
                <Button
                    android:id="@+id/botonAtras"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:backgroundTint="@color/lightGray"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:cornerRadius="1dp" />
            </LinearLayout>

        </LinearLayout>
        <ImageButton
            android:id="@+id/botonInfo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="end"
            android:layout_margin="30dp"
            android:background="@drawable/round_button_background"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:tint="@color/purple"
            app:srcCompat="@android:drawable/ic_dialog_info" />
    </LinearLayout>
</ScrollView>